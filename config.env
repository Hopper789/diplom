# === BOINC SERVER SETTINGS ===

PROJECT_NAME="project"
PROJECT_URL="http://192.168.1.10/boinc"
SERVER_IP="192.168.1.10"

DB_NAME="boinc_bd"
DB_USER="boincadm"
DB_PASSWORD="123"

BOINC_SRC_DIR="$HOME/boinc-src"
BOINC_PROJECTS_DIR="$HOME/boinc_projects"

# === CLUSTER SETTINGS ===

SSH_USER="student"
SSH_PRIVATE_KEY="$HOME/.ssh/id_rsa"

# === BOINC CLIENT SETTINGS ===

BOINC_CLIENT_PACKAGE="boinc-client"

# После создания пользователя проекта сюда нужно вставить account key
ACCOUNT_KEY="PASTE_ACCOUNT_KEY_HERE"

# === TASK SETTINGS ===

TASK_APP_NAME="ml_grid_search"
PYTHON_VERSION="python3"