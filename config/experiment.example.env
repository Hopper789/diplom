# Experiment target duration in seconds.
# This is used only to calculate how many small BOINC workunits to create.
EXPERIMENT_WALL_SECONDS=180

# Approximate number of CPU cores on one compute node.
# Used only when TASK_COUNT is empty.
EXPERIMENT_CORES=12

# Approximate duration of one small workunit in seconds.
TASK_SECONDS=8

# If empty, task count is calculated automatically:
# ceil(EXPERIMENT_WALL_SECONDS * EXPERIMENT_CORES / TASK_SECONDS)
# Example: 180 * 12 / 8 = 270 tasks.
# Set a number manually if you need exact control.
TASK_COUNT=

# BOINC app metadata. APP_VERSION is part of the BOINC app binary name.
APP_NAME=ml_grid_search
APP_VERSION=1.04
PLATFORM=x86_64-pc-linux-gnu

# Synthetic input size used by the demo application.
TASK_DATASET_SIZE=500

# Base value for task seeds. Each workunit gets TASK_SEED_BASE + task_id.
TASK_SEED_BASE=1000
