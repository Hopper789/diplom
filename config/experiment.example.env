# Какую задачу запускать через ./scripts/run_experiment.sh и quickstart --run-experiment.
# Варианты: ml_grid_search, big_determinant, python_task_runner.
# Для произвольной команды можно задать EXPERIMENT_TASK_CMD.
EXPERIMENT_APP=ml_grid_search

# Целевая длительность эксперимента в секундах.
# Используется только для расчёта количества BOINC workunits, если TASK_COUNT пустой.
EXPERIMENT_WALL_SECONDS=1200

# Примерное число параллельных BOINC CPU-задач.
# Используется только если TASK_COUNT пустой.
EXPERIMENT_CORES=1

# Примерная длительность одной BOINC workunit в секундах.
# 1200 = около 20 минут на вычисление одной задачи.
TASK_SECONDS=1200

# Если пусто, число задач считается автоматически:
# ceil(EXPERIMENT_WALL_SECONDS * EXPERIMENT_CORES / TASK_SECONDS)
# Пример: 1200 * 2 / 1200 = 2 задачи.
# Укажи число вручную, если нужен точный контроль.
TASK_COUNT=

# Метаданные BOINC-приложения для ml_grid_search.
# Если APP_VERSION пустой, Python runner автоматически создаёт следующую версию.
APP_NAME=ml_grid_search
APP_VERSION=
PLATFORM=x86_64-pc-linux-gnu

# Размер синтетического входа для демонстрационного приложения.
TASK_DATASET_SIZE=500

# Базовое значение seed. Каждая задача BOINC получает TASK_SEED_BASE + task_id.
TASK_SEED_BASE=1000

# Сетка regularization/lambda для перебора параметров.
TASK_LAMBDA_GRID=0,0.001,0.003,0.01,0.03,0.1,0.3,1,3,10

# Для EXPERIMENT_APP=python_task_runner:
# PYTHON_TASK_FILE=apps/python_task_runner/examples/synthetic_cpu/user_task.py
# PYTHON_TASK_PARAMS=apps/python_task_runner/examples/synthetic_cpu/params.jsonl
# PYTHON_TASK_DEVICE=cpu

# Для полностью кастомного запуска:
# EXPERIMENT_TASK_CMD='apps/big_determinant/run_task.sh boinc'
