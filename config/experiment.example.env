# Experiment duration target.
# Approximate wall-time on one machine in seconds.
EXPERIMENT_WALL_SECONDS=180

# Approximate number of CPU cores on one machine.
# Used only when TASK_COUNT is empty.
EXPERIMENT_CORES=12

# Approximate CPU time of one small workunit in seconds.
TASK_SECONDS=8

# If empty, task count is calculated automatically:
# ceil(EXPERIMENT_WALL_SECONDS * EXPERIMENT_CORES / TASK_SECONDS)
# Example: 180 * 12 / 8 = 270 tasks
TASK_COUNT=

# BOINC app metadata
APP_NAME=ml_grid_search
APP_VERSION=1.04
PLATFORM=x86_64-pc-linux-gnu

# Synthetic dataset size inside each task
TASK_DATASET_SIZE=500

# Seed base for generated tasks
TASK_SEED_BASE=1000