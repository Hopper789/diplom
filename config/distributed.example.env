# Конфигурация распределённого выполнения BOINC.
# Скопируй файл в config/distributed.env и меняй локальную копию.
# Эти значения используются при генерации шаблона задачи BOINC.

# Сколько result-записей BOINC старается держать для одной задачи.
# Это стартовая/целевая выдача, а не верхний лимит.
# Например для "2 из 3" обычно ставят target_nresults=2 и max_total_results=3.
DISTRIBUTED_TARGET_NRESULTS=1

# Сколько успешных совпадающих результатов нужно для подтверждения задачи.
DISTRIBUTED_MIN_QUORUM=1

# Максимум успешных результатов для одной задачи.
# Если нужно остановиться после quorum, ставь равным DISTRIBUTED_MIN_QUORUM.
DISTRIBUTED_MAX_SUCCESS_RESULTS=1

# Максимум ошибочных попыток.
DISTRIBUTED_MAX_ERROR_RESULTS=3

# Максимум всех попыток выполнения.
DISTRIBUTED_MAX_TOTAL_RESULTS=3

# Максимальный срок возврата результата в секундах: 86400 = 1 день.
DISTRIBUTED_DELAY_BOUND=86400

# Оценки и ограничения ресурсов для планировщика BOINC.
DISTRIBUTED_RSC_MEMORY_BOUND=268435456
DISTRIBUTED_RSC_DISK_BOUND=104857600
DISTRIBUTED_RSC_FPOPS_EST=100000000000.0
DISTRIBUTED_RSC_FPOPS_BOUND=10000000000000.0
