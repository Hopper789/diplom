# BOINC distributed-computing configuration.
# Copy to config/distributed.env and edit before running an experiment.
# These parameters are used to generate the BOINC workunit input template.

# How many result records the server should try to create per workunit.
# 1 = no replication; 2 = duplicate each task; 3 = triple execution, etc. 1
DISTRIBUTED_TARGET_NRESULTS=3

# How many successful matching results are required to consider a workunit valid.
# 1 = accept the first successful result; 2 = require two matching replicas. 1
DISTRIBUTED_MIN_QUORUM=2

# Maximum successful results accepted for one workunit. 1
DISTRIBUTED_MAX_SUCCESS_RESULTS=2

# Maximum failed results before the workunit is considered problematic. 3
DISTRIBUTED_MAX_ERROR_RESULTS=1

# Maximum total result attempts for one workunit. 3
DISTRIBUTED_MAX_TOTAL_RESULTS=10

# Deadline for returning a result, in seconds.
DISTRIBUTED_DELAY_BOUND=86400

# BOINC resource estimates/bounds.
# They help BOINC schedule work and reject runaway tasks.
DISTRIBUTED_RSC_FPOPS_EST=100000000000
DISTRIBUTED_RSC_FPOPS_BOUND=10000000000000
DISTRIBUTED_RSC_MEMORY_BOUND=268435456
DISTRIBUTED_RSC_DISK_BOUND=104857600
