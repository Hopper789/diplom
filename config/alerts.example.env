# Токен Telegram-бота из BotFather.
TELEGRAM_BOT_TOKEN=

# Идентификатор чата пользователя, группы или канала, куда отправлять уведомления.
TELEGRAM_CHAT_ID=

# Пауза между проверками метрик экспортера BOINC.
ALERT_POLL_INTERVAL_SECONDS=30

# Адрес экспортера BOINC внутри Docker-сети monitoring.
BOINC_EXPORTER_URL=http://boinc-exporter:9101/metrics

# Файл состояния уведомителя, чтобы не отправлять одно уведомление много раз.
ALERT_STATE_FILE=/state/alerts_state.json
