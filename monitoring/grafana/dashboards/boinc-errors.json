{
  "uid": "boinc-errors",
  "title": "BOINC Errors",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "tags": [
    "boinc",
    "errors",
    "loki"
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Errors in last 5m",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({cluster=\"boinc\"} |~ \"(?i)(error|failed|exception|traceback|fatal|panic|timeout|denied|refused|critical|bad WU template|no <file_info>|no <workunit>|output file.*absent|platform.*not found)\"[5m]))",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "timeseries",
      "title": "Error categories",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(count_over_time({cluster=\"boinc\"} |~ \"(?i)(bad WU template|no <file_info>|no <workunit>|create_work|xadd|update_versions|template)\"[5m]))",
          "legendFormat": "templates/workunits",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "sum(count_over_time({cluster=\"boinc\"} |~ \"(?i)(boinccmd|project attach|project_attach|scheduler request failed|client.*error|gui_rpc_auth|output file.*absent)\"[5m]))",
          "legendFormat": "client/rpc",
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "sum(count_over_time({cluster=\"boinc\"} |~ \"(?i)(mariadb|database|db.*error|connection refused|can't connect)\"[5m]))",
          "legendFormat": "database",
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "sum(count_over_time({cluster=\"boinc\"} |~ \"(?i)(docker.*error|no such container|cannot connect to docker|permission denied|denied|pull access denied)\"[5m]))",
          "legendFormat": "docker/permissions",
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "sum(count_over_time({cluster=\"boinc\"} |~ \"(?i)(ansible|ssh|unreachable|host key verification|permission denied|failed to connect)\"[5m]))",
          "legendFormat": "ansible/ssh",
          "refId": "E",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "sum(count_over_time({cluster=\"boinc\"} |~ \"(?i)(platform.*not found|doesn't support computers|no tasks available|Sending reply.*0 results)\"[5m]))",
          "legendFormat": "scheduler/platform",
          "refId": "F",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "logs",
      "title": "Recent error logs",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "expr": "{cluster=\"boinc\"} |~ \"(?i)(error|failed|exception|traceback|fatal|panic|timeout|denied|refused|critical|bad WU template|no <file_info>|no <workunit>|boinccmd|output file.*absent|platform.*not found|no tasks available)\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "logs",
      "title": "BOINC server and scheduler logs",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{cluster=\"boinc\", job=\"boinc-project-logs\", node_role=\"server\"}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "type": "logs",
      "title": "Remote client logs",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{cluster=\"boinc\", node_role=\"client\"}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
