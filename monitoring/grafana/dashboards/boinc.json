    {
      "type": "timeseries",
      "title": "Client network traffic",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(instance, device) (rate(node_network_receive_bytes_total{job=\"node_exporter_clients\",device!~\"lo|docker.*|veth.*|br.*\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{instance}} {{device}} rx",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by(instance, device) (rate(node_network_transmit_bytes_total{job=\"node_exporter_clients\",device!~\"lo|docker.*|veth.*|br.*\"}[1m]))",
          "refId": "B",
          "legendFormat": "{{instance}} {{device}} tx",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "description": "Network traffic on real host interfaces. Docker, bridge, veth and loopback interfaces are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Client cAdvisor CPU",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(instance) (rate(container_cpu_usage_seconds_total{job=\"cadvisor_clients\",id!=\"/\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{instance}} cAdvisor CPU",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "description": "Aggregated client cAdvisor CPU for tracked cgroups/containers. Some cAdvisor versions do not expose Docker container names, so this is broader than only boinc-client.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Client cAdvisor memory",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
