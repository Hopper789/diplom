      "targets": [
        {
          "expr": "node_load1{job=\"node_exporter_clients\"}",
          "refId": "A",
          "legendFormat": "{{instance}} load1",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "node_load5{job=\"node_exporter_clients\"}",
