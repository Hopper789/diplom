        {
          "expr": "boinc_actual_results_per_workunit",
          "refId": "A",
          "legendFormat": "actual results/workunit"
        },
        {
          "expr": "boinc_replication_overhead",
          "refId": "A",
          "legendFormat": "replication overhead"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
