          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Results",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "boinc_results_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Finished results",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "boinc_results_finished_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Error results",
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "boinc_results_error_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Replication",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "boinc_config_replication_factor",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Min quorum",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "boinc_config_min_quorum",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Avg compute/WU",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "boinc_avg_compute_time_per_workunit_seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Avg overhead/WU",
      "gridPos": {
        "x": 20,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "boinc_avg_overhead_time_per_workunit_seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "BOINC queue and completion",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boinc_queue_remaining_total",
          "refId": "A",
          "legendFormat": "queue remaining"
        },
        {
          "expr": "boinc_results_finished_total",
          "refId": "B",
          "legendFormat": "finished results"
        },
        {
          "expr": "boinc_completed_workunits_total",
          "refId": "C",
          "legendFormat": "completed workunits"
        },
        {
          "expr": "boinc_results_success_total",
          "refId": "D",
          "legendFormat": "successful results"
        },
        {
          "expr": "boinc_results_error_total",
          "refId": "E",
          "legendFormat": "error results"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "BOINC results by outcome",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boinc_results_by_outcome_total",
          "refId": "A",
          "legendFormat": "outcome {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "clamp_min(delta(boinc_results_success_total[1m]), 0)",
          "refId": "A",
          "legendFormat": "successful results/min"
        },
        {
          "expr": "clamp_min(delta(boinc_completed_workunits_total[1m]), 0)",
          "refId": "B",
          "legendFormat": "completed workunits/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "description": "Tasks completed per minute. Uses delta() because BOINC exporter exposes these values as gauges."
    },
    {
      "type": "timeseries",
      "title": "Turnaround time",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boinc_avg_success_turnaround_seconds",
          "refId": "A",
          "legendFormat": "avg turnaround"
        },
        {
          "expr": "boinc_p95_success_turnaround_seconds",
          "refId": "B",
          "legendFormat": "p95 turnaround"
        },
        {
          "expr": "boinc_avg_compute_time_per_workunit_seconds",
          "refId": "C",
          "legendFormat": "avg compute/WU"
        },
        {
          "expr": "boinc_avg_overhead_time_per_workunit_seconds",
          "refId": "D",
          "legendFormat": "avg overhead/WU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Replication configuration",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boinc_config_replication_factor",
          "refId": "A",
          "legendFormat": "configured replication"
        },
        {
          "expr": "boinc_actual_results_per_workunit",
          "refId": "B",
          "legendFormat": "actual results/workunit"
        },
        {
          "expr": "boinc_target_nresults_avg",
          "refId": "C",
          "legendFormat": "DB target_nresults avg"
        },
        {
          "expr": "boinc_max_success_results_avg",
          "refId": "D",
          "legendFormat": "max success avg"
        },
        {
          "expr": "boinc_max_total_results_avg",
          "refId": "E",
          "legendFormat": "max total avg"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Error results over time",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boinc_results_error_total",
          "refId": "A",
          "legendFormat": "error results"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Client CPU usage",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{job=\"node_exporter_clients\",mode=\"idle\"}[1m])))",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Client memory usage",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node_exporter_clients\"} / node_memory_MemTotal_bytes{job=\"node_exporter_clients\"})",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Client load average",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "node_load1{job=\"node_exporter_clients\"}",
          "refId": "A",
          "legendFormat": "{{instance}} load1"
        },
        {
          "expr": "node_load5{job=\"node_exporter_clients\"}",
          "refId": "B",
          "legendFormat": "{{instance}} load5"
        },
        {
          "expr": "node_load15{job=\"node_exporter_clients\"}",
          "refId": "C",
          "legendFormat": "{{instance}} load15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Client network traffic",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(instance, device) (rate(node_network_receive_bytes_total{job=\"node_exporter_clients\",device!~\"lo|docker.*|veth.*|br.*\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{instance}} {{device}} rx"
        },
        {
          "expr": "sum by(instance, device) (rate(node_network_transmit_bytes_total{job=\"node_exporter_clients\",device!~\"lo|docker.*|veth.*|br.*\"}[1m]))",
          "refId": "B",
          "legendFormat": "{{instance}} {{device}} tx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "description": "Network traffic on real host interfaces. Docker, bridge, veth and loopback interfaces are excluded."
    },
    {
      "type": "timeseries",
      "title": "Client cAdvisor CPU",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(instance) (rate(container_cpu_usage_seconds_total{job=\"cadvisor_clients\",id!=\"/\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{instance}} cAdvisor CPU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "description": "Aggregated client cAdvisor CPU for tracked cgroups/containers. Some cAdvisor versions do not expose Docker container names, so this is broader than only boinc-client."
    },
    {
      "type": "timeseries",
      "title": "Client cAdvisor memory",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(instance) (container_memory_usage_bytes{job=\"cadvisor_clients\",id!=\"/\"})",
          "refId": "A",
          "legendFormat": "{{instance}} cAdvisor memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "description": "Aggregated client cAdvisor memory for tracked cgroups/containers. Some cAdvisor versions do not expose Docker container names, so this is broader than only boinc-client."
    },
    {
      "type": "timeseries",
      "title": "Server cAdvisor CPU",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(instance) (rate(container_cpu_usage_seconds_total{job=\"cadvisor_server\",id!=\"/\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{instance}} cAdvisor CPU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "description": "Aggregated server cAdvisor CPU for tracked cgroups/containers. This avoids depending on unstable Docker name labels."
    },
    {
      "type": "timeseries",
      "title": "Server cAdvisor memory",
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(instance) (container_memory_usage_bytes{job=\"cadvisor_server\",id!=\"/\"})",
          "refId": "A",
          "legendFormat": "{{instance}} cAdvisor memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "description": "Aggregated server cAdvisor memory for tracked cgroups/containers. This avoids depending on unstable Docker name labels."
    }
  ]
}