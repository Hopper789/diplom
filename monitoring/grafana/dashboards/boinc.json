      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boinc_results_unsent_total",
          "refId": "A",
          "legendFormat": "unsent"
        },
        {
          "expr": "boinc_results_assigned_total",
          "refId": "A",
          "legendFormat": "assigned"
        },
        {
          "expr": "boinc_results_in_progress_total",
          "refId": "A",
          "legendFormat": "in progress"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Client CPU usage",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{job=\"node_exporter_clients\",mode=\"idle\"}[1m])))",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Client memory usage",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node_exporter_clients\"} / node_memory_MemTotal_bytes{job=\"node_exporter_clients\"})",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Client load average",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "node_load1{job=\"node_exporter_clients\"}",
          "refId": "A",
          "legendFormat": "{{instance}} load1"
        },
        {
          "expr": "node_load5{job=\"node_exporter_clients\"}",
          "refId": "A",
          "legendFormat": "{{instance}} load5"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Client network traffic",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{job=\"node_exporter_clients\",device!~\"lo|docker.*|veth.*|br.*\"}[1m])",
          "refId": "A",
          "legendFormat": "{{instance}} rx"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{job=\"node_exporter_clients\",device!~\"lo|docker.*|veth.*|br.*\"}[1m])",
          "refId": "A",
          "legendFormat": "{{instance}} tx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "BOINC container CPU",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{job=\"cadvisor_clients\",name=\"boinc-client\"}[1m])",
          "refId": "A",
          "legendFormat": "{{instance}} boinc-client"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "BOINC container memory",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{job=\"cadvisor_clients\",name=\"boinc-client\"}",
          "refId": "A",
          "legendFormat": "{{instance}} boinc-client"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Server containers CPU",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{job=\"cadvisor_server\",name=~\"boinc-server|boinc-mysql|boinc-exporter|boinc-prometheus|boinc-grafana\"}[1m])",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Server containers memory",
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{job=\"cadvisor_server\",name=~\"boinc-server|boinc-mysql|boinc-exporter|boinc-prometheus|boinc-grafana\"}",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    }
