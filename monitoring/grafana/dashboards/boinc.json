        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boinc_results_unfinished_total",
          "refId": "A",
          "legendFormat": "unfinished"
        },
        {
          "expr": "boinc_results_finished_total",
          "refId": "A",
          "legendFormat": "finished"
        },
        {
          "expr": "boinc_results_success_total",
          "refId": "A",
          "legendFormat": "success"
        },
        {
          "expr": "boinc_results_error_total",
          "refId": "A",
          "legendFormat": "errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "BOINC results by outcome",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boinc_results_by_outcome_total",
          "refId": "A",
          "legendFormat": "outcome {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(boinc_results_success_total[5m]) * 60",
          "refId": "A",
          "legendFormat": "successful results/min"
        },
        {
          "expr": "rate(boinc_completed_workunits_total[5m]) * 60",
          "refId": "A",
          "legendFormat": "completed workunits/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Turnaround time",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "boinc_avg_success_turnaround_seconds",
          "refId": "A",
          "legendFormat": "avg success turnaround"
        },
        {
          "expr": "boinc_p95_success_turnaround_seconds",
          "refId": "A",
          "legendFormat": "p95 success turnaround"
        },
        {
          "expr": "boinc_oldest_unfinished_result_age_seconds",
          "refId": "A",
          "legendFormat": "oldest unfinished age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
