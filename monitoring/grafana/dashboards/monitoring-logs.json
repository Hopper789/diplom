{
  "uid": "monitoring-logs",
  "title": "Monitoring Logs",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": [
    "monitoring",
    "logs",
    "loki"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Monitoring errors in last 5m",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(count_over_time({cluster=\"boinc\", job=\"docker\"} |~ \"(?i)(loki|grafana|promtail|prometheus|error|failed|exception|timeout|denied|refused|context canceled|scheduler_processor.go|retry.go)\"[5m]))",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "All monitoring/system docker logs",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 8
      },
      "targets": [
        {
          "expr": "{cluster=\"boinc\", job=\"docker\"}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Loki/Grafana query errors",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{cluster=\"boinc\", job=\"docker\"} |~ \"(?i)(loki|grafana|scheduler_processor.go|retry.go|context canceled|finished query|error notifying scheduler|error notifying frontend|error health checking|grpc: the client connection is closing|use of closed network connection|EOF)\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Promtail errors",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{cluster=\"boinc\", job=\"docker\"} |~ \"(?i)(promtail|tailer|filetarget|positions|permission denied|no such file|error)\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Grafana errors",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{cluster=\"boinc\", job=\"docker\"} |~ \"(?i)(grafana|tsdb.loki|datasource|dashboard|query error|statusCode=400|statusCode=500|parse error|bad_data)\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Loki internal errors",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{cluster=\"boinc\", job=\"docker\"} |~ \"(?i)(loki|scheduler_processor.go|retry.go|context canceled|frontend|query_range|error notifying scheduler|error notifying frontend|EOF)\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Docker/deploy errors",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "{cluster=\"boinc\", job=\"docker\"} |~ \"(?i)(docker.*error|no such container|cannot connect to docker|permission denied|denied|pull access denied|ansible|ssh|unreachable|host key verification|failed to connect)\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
